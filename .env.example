# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# PostgreSQL Database URL
# For local Docker: postgresql+asyncpg://matchmaker_user:secretpassword@localhost:5444/matchmaker_db
# For Railway: ${{Postgres.DATABASE_URL}} (automatically normalized by app/config/settings.py)
DATABASE_URL=postgresql+asyncpg://matchmaker_user:secretpassword@localhost:5444/matchmaker_db

# Redis URL
# For local Docker: redis://localhost:6379/0
# For Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0

# Optional Queue Timing Parameters (defaults shown)
QUEUE_HARD_DEGRADE_SECONDS=10
QUEUE_MAX_WAIT_SECONDS=60

# Optional Rate Limiting Parameters (defaults shown)
RATE_LIMIT_MESSAGES_PER_SEC=5
RATE_LIMIT_ACTIONS_PER_MIN=30