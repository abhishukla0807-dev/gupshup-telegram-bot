# ==============================================================================
# GupShup Telegram Matchmaker Environment Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Database & Redis Settings
# Note: In docker-compose.prod.yml on AWS EC2, the defaults below connect
# directly through the private internal Docker bridge network automatically.
# ------------------------------------------------------------------------------
POSTGRES_USER=matchmaker_user
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=matchmaker_db

# Local development URL (or override if using AWS RDS):
DATABASE_URL=postgresql+asyncpg://matchmaker_user:secretpassword@localhost:5444/matchmaker_db

# Redis connection URL:
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Optional Matchmaking Degradation & Timeout Configuration
# ------------------------------------------------------------------------------
MATCHMAKING_HARD_CONSTRAINT_TIMEOUT_SECONDS=10.0
MATCHMAKING_MAX_QUEUE_WAIT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Optional Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_SEARCH_REFILL_PERIOD_SECONDS=3.0
RATE_LIMIT_ACTIONS_PER_MIN=30

# ------------------------------------------------------------------------------
# Optional Content Moderation Configuration
# ------------------------------------------------------------------------------
MODERATION_BLOCK_USERNAMES=true
MODERATION_BLOCK_URLS=true